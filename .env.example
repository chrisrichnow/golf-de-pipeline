# Copy this file to .env and fill in real values. .env is gitignored — never commit real keys.

# --- API keys ---
SLASH_GOLF_API_KEY=
DATA_GOLF_API_KEY=

# --- Golf data Postgres (staging tables + deliverable table) ---
GOLF_DB_USER=golf
GOLF_DB_PASSWORD=changeme
GOLF_DB_NAME=golf_data
GOLF_DB_PORT=5433

# --- Airflow metadata Postgres (separate DB from golf data — don't merge these) ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# --- Airflow ---
# On Linux, set this to your host UID (id -u) to avoid file-permission issues on mounted volumes.
# On Windows/Docker Desktop this can stay as-is.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
